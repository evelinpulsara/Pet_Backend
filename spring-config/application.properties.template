# ============================================================
#  application.properties — Sistema de Rastreo de Mascotas con IA
#  Spring Boot 3.3.x | Java 21
# ============================================================
# INSTRUCCIONES:
#  1. Copia este archivo a src/main/resources/application.properties
#  2. AGREGA application.properties a tu .gitignore (¡nunca subir credenciales!)
#  3. Reemplaza los valores ${VAR:default} con tus datos reales
#     O mejor: define las variables de entorno en tu sistema / servicio cloud.
# ============================================================

# ---- Servidor ----
server.port=${PORT:8080}
server.servlet.context-path=/api/v1

# ---- Base de Datos PostgreSQL ----
# Neon (recomendado gratuito): postgresql://user:pass@ep-xxxxx.us-east-2.aws.neon.tech/pettracker?sslmode=require
# Supabase:                     postgresql://postgres:pass@db.xxxxxx.supabase.co:5432/postgres
# Local:                        localhost:5432

spring.datasource.url=jdbc:postgresql://${DB_HOST:localhost}:${DB_PORT:5432}/${DB_NAME:pet_tracker_db}?sslmode=${DB_SSL_MODE:prefer}
spring.datasource.username=${DB_USERNAME:postgres}
spring.datasource.password=${DB_PASSWORD:}
spring.datasource.driver-class-name=org.postgresql.Driver

# ---- HikariCP (pool de conexiones) ----
spring.datasource.hikari.maximum-pool-size=10
spring.datasource.hikari.minimum-idle=2
spring.datasource.hikari.connection-timeout=30000
spring.datasource.hikari.idle-timeout=600000
spring.datasource.hikari.max-lifetime=1800000
# Neon y Supabase usan SSL — asegura que la conexión no se corte
spring.datasource.hikari.keepalive-time=60000
spring.datasource.hikari.connection-test-query=SELECT 1

# ---- JPA / Hibernate ----
# 'validate' : solo verifica que el esquema exista (para producción)
# 'update'   : modifica el esquema automáticamente (solo desarrollo)
# NUNCA uses 'create' o 'create-drop' si ya tienes datos reales
spring.jpa.hibernate.ddl-auto=${JPA_DDL:validate}
spring.jpa.show-sql=${JPA_SHOW_SQL:false}
spring.jpa.open-in-view=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.properties.hibernate.jdbc.time_zone=UTC
spring.jpa.properties.hibernate.format_sql=false
# PostGIS — descomenta si usas el tipo GEOGRAPHY en tu esquema
# spring.jpa.properties.hibernate.spatial.enabled=true

# ---- Flyway (migraciones de base de datos) ----
# Flyway aplica los scripts SQL en orden automáticamente.
# Scripts en: src/main/resources/db/migration/
# Nombres:    V1__schema.sql, V2__sample_data.sql, V3__nueva_tabla.sql ...
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration
spring.flyway.baseline-on-migrate=true
spring.flyway.validate-on-migrate=true
spring.flyway.schemas=public

# ---- JWT (Spring Security) ----
# IMPORTANTE: Usa una clave de mínimo 256 bits (32 caracteres aleatorios).
# Genera una segura con: openssl rand -base64 64
app.jwt.secret=${JWT_SECRET:CAMBIA-ESTE-SECRETO-POR-UNO-REAL-DE-256-BITS-EN-PRODUCCION}
app.jwt.access-token-expiration-ms=${JWT_ACCESS_EXPIRATION_MS:900000}    # 15 minutos
app.jwt.refresh-token-expiration-ms=${JWT_REFRESH_EXPIRATION_MS:604800000}  # 7 días

# ---- BCrypt ----
# Factor de costo 12 = ~250ms por hash (balance entre seguridad y rendimiento)
app.security.bcrypt-strength=${BCRYPT_STRENGTH:12}

# ---- Row Level Security (PostgreSQL) ----
# La app debe configurar esto al inicio de cada sesión JDBC.
# Se implementa en un Interceptor o AOP antes de cada operación.
app.rls.setting-key=app.current_user_id

# ---- Almacenamiento de imágenes (mascotas/fotos) ----
# No guardes imágenes en la base de datos. Usa un servicio externo.
# Opciones gratuitas (académico): Cloudinary free tier, Supabase Storage
app.storage.provider=${STORAGE_PROVIDER:local}   # 'local', 'cloudinary', 'supabase'
app.storage.base-url=${STORAGE_BASE_URL:http://localhost:8080/uploads}

# ---- Actuator (monitoreo) ----
management.endpoints.web.exposure.include=${ACTUATOR_ENDPOINTS:health,info}
management.endpoint.health.show-details=when-authorized
management.info.env.enabled=true

# ---- CORS (para conectar con tu frontend) ----
app.cors.allowed-origins=${CORS_ORIGINS:http://localhost:3000,http://localhost:4200}
app.cors.allowed-methods=GET,POST,PUT,PATCH,DELETE,OPTIONS
app.cors.max-age=3600

# ---- Logging ----
logging.level.root=WARN
logging.level.com.tuuniversidad=INFO
logging.level.org.springframework.security=WARN
# En desarrollo, activa SQL logging:
# logging.level.org.hibernate.SQL=DEBUG

<?xml version="1.0" encoding="UTF-8"?>
<!--
  PetTracker — Backend (Spring Boot)
  Se despliega en Render (Docker). Hace de intermediario seguro entre la app
  (Vercel) y los servicios externos:
    - IA (Gemini): la clave vive solo aquí, nunca en la app.
    - Collar GPS: recibe la ubicación del dispositivo y la guarda en Supabase.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.pettracker</groupId>
    <artifactId>pettracker-backend</artifactId>
    <version>1.0.0</version>
    <name>PetTracker Backend</name>
    <description>API de PetTracker: IA segura y entrada del collar GPS</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- API REST + SSE -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Validación de datos de entrada en tiempo de ejecución (@NotBlank, @DecimalMin...) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- /actuator/health para que Render sepa que el servicio está vivo -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>pettracker-backend</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
